# -- Waveform Configuration --

add wave -noupdate -divider "Clock & PC"
add wave -noupdate -radix binary /cpu_tb/CLK
add wave -noupdate -radix unsigned /cpu_tb/PC
add wave -noupdate -radix unsigned /cpu_tb/core/temp_pc

add wave -noupdate -divider "Instruction & Decode"
add wave -noupdate -radix hexadecimal /cpu_tb/INSTRUCT_MEM_OUT
add wave -noupdate -radix binary /cpu_tb/core/main_ctrl/opcode

add wave -noupdate -divider "CBZ Datapath (Zero Check)"
add wave -noupdate -radix unsigned /cpu_tb/RD_REG2
add wave -noupdate -radix decimal /cpu_tb/RD_DATA2
add wave -noupdate -radix binary /cpu_tb/core/CTRL_ALU_OP
add wave -noupdate -radix binary /cpu_tb/core/ALU_CTRL_OUT
add wave -noupdate -radix decimal /cpu_tb/core/ALU_ARG2
add wave -noupdate -radix decimal /cpu_tb/core/ALU_RESULT
add wave -noupdate -color {Orange} -radix binary /cpu_tb/core/ALU_zero_flag

add wave -noupdate -divider "CBZ Branch Logic"
add wave -noupdate -radix binary /cpu_tb/core/CTRL_BRANCH
add wave -noupdate -color {Orange} -radix binary /cpu_tb/core/branch_zero
add wave -noupdate -color {Red} -radix binary /cpu_tb/core/CTRL_JUMP

add wave -noupdate -divider "Branch Target Calculation"
add wave -noupdate -radix decimal /cpu_tb/core/INSTRUCT_SIGN_EXT
add wave -noupdate -radix decimal /cpu_tb/core/immd_shifted
add wave -noupdate -radix unsigned /cpu_tb/core/PC_plus4
add wave -noupdate -radix unsigned /cpu_tb/core/PC_ALU_out

# -- Format and Run --
TreeUpdate [SetDefaultTree]
WaveRestoreCursors {{CBZ Execute} {50 ns} 0}
configure wave -namecolwidth 250
configure wave -valuecolwidth 100
configure wave -justifyvalue left
configure wave -signalnamewidth 1
configure wave -timelineunits ns

# Run past PC=16 (CBZ R1, #2 happens around 40ns - 50ns)
run 80 ns
do run.do
